@using eShop.WebAppComponents.Item
@inject IProductImageUrlProvider ProductImages

<div class="catalog-item">
    <a class="catalog-product" href="@ItemHelper.Url(Item)" data-enhance-nav="false">
        <span class='catalog-product-image'>
            <img alt="@Item.Name" src='@ProductImages.GetProductImageUrl(Item)' />
        </span>
        <span class='catalog-product-content'>
            <span class='catalog-product-line'>
                <span class='name'>@GetTitleFirstLine()</span>
                <span class='price'>$@Item.Price.ToString("0.00")</span>
            </span>
            <span class='catalog-product-line'>
                <span class='name-continuation'>@GetTitleContinuation()</span>
                <span class='warehouse-status @GetStatusClass()'>@GetStatusText()</span>
            </span>
        </span>
    </a>
</div>

@code {
    [Parameter, EditorRequired]
    public required CatalogItem Item { get; set; }

    [Parameter]
    public bool IsLoggedIn { get; set; }

    private const int MaxTitleLength = 25; // Adjust based on design needs

    private string GetTitleFirstLine()
    {
        if (Item.Name.Length <= MaxTitleLength)
            return Item.Name;

        // Find the last space before the max length to avoid breaking words
        int lastSpace = Item.Name.LastIndexOf(' ', MaxTitleLength);
        if (lastSpace > 0)
            return Item.Name.Substring(0, lastSpace);
        
        // If no space found, truncate at max length
        return Item.Name.Substring(0, MaxTitleLength);
    }

    private string GetTitleContinuation()
    {
        if (Item.Name.Length <= MaxTitleLength)
            return string.Empty;

        int lastSpace = Item.Name.LastIndexOf(' ', MaxTitleLength);
        if (lastSpace > 0)
            return Item.Name.Substring(lastSpace + 1);
        
        return Item.Name.Substring(MaxTitleLength);
    }

    private string GetStatusText()
    {
        return Item.AvailableStock > 0 ? "In stock" : "Out of stock";
    }

    private string GetStatusClass()
    {
        return Item.AvailableStock > 0 ? "in-stock" : "out-of-stock";
    }
}
